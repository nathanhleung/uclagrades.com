{
  "name": "uclagrades.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "ts-node --compilerOptions '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' data/clean.ts && ts-node --compilerOptions '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' data/get-course-details.ts",
    "dev": "next dev --webpack",
    "build": "yarn run generate && NEXT_PUBLIC_COMMIT_HASH=$(git rev-parse HEAD) next build --webpack",
    "lint": "eslint .",
    "format": "prettier . --write"
  },
  "dependencies": {
    "autoprefixer": "10.6.2",
    "chart.js": "^4.6.1",
    "classnames": "^2.3.2",
    "csv": "^6.6.4",
    "date-fns": "^2.30.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "fuse.js": "^7.5.0",
    "lodash": "^4.18.1",
    "multistream": "^4.1.0",
    "next": "16.4.6",
    "postcss": "8.5.33",
    "react": "19.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.3.1",
    "react-fast-marquee": "^1.6.1",
    "react-modal": "^3.16.3",
    "react-select": "^5.10.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.200",
    "@types/multistream": "^4.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-modal": "^3.16.3",
    "eslint-config-prettier": "^10.1.8",
    "mkdirp": "^3.0.1",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.1"
  },
  "packageManager": "yarn@4.18.1"
}
